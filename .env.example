PORT=3001
HOST=127.0.0.1
APP_URL=http://localhost:5173
DATA_DIR=./data
NODE_ENV=development
# Production (Render/Railway): set NODE_ENV=production, APP_URL=https://url-kamu.onrender.com,
# HOST=0.0.0.0, DATA_DIR=/var/data, TRUST_PROXY=1
TRUST_PROXY=0

# Signing key for session cookies. Gunakan nilai acak panjang di production.
# SESSION_SECRET=ganti-dengan-kunci-acak-panjang

# Opsional: buat atau perbarui akun admin saat server pertama kali start.
# ADMIN_EMAIL=admin@contoh.id
# ADMIN_PASSWORD=ganti-dengan-kata-sandi-panjang
# ADMIN_NAME=Admin Digital Garden

# Set ke 1 untuk menyajikan frontend dari Express di luar mode production.
# SERVE_STATIC=0
# BACKUP_DIR=./backups
